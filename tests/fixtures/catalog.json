{
  "format_version": 1,
  "tasks": [
    {
      "id": "toy_opt",
      "title": "Toy optimization",
      "description": "Covers every parameter kind.",
      "category": "Optimizers",
      "module": "toy.opt_driver",
      "resources": {"cpus": 2, "memory_mb": 1000, "walltime_minutes": 10},
      "platform_flags": {"job_name": "-JOBNAME", "cpus": "-parallel"},
      "inputs": [
        {
          "name": "structure",
          "flag": "-i",
          "formats": ["xyz"],
          "required": false,
          "multiple": false
        }
      ],
      "outputs": [{"name": "structure", "glob": "*_optimized.xyz"}],
      "parameters": [
        {"name": "charge", "flag": "-charge", "kind": "integer", "default": 0},
        {
          "name": "temp",
          "flag": "-temp",
          "kind": "number",
          "default": 300.0,
          "unit": "K",
          "minimum": 0
        },
        {
          "name": "gfnff",
          "flag": "-gfnff",
          "kind": "boolean",
          "default": false
        },
        {"name": "keep", "flag": "-nokeep", "kind": "boolean", "default": true},
        {
          "name": "optlevel",
          "flag": "-optlevel",
          "kind": "string",
          "default": "normal",
          "choices": ["normal", "tight"]
        },
        {
          "name": "gfn",
          "flag": "-gfn",
          "kind": "integer",
          "default": 2,
          "choices": [0, 1, 2]
        },
        {"name": "solvent", "flag": "-solvent", "kind": "string"}
      ]
    },
    {
      "id": "toy_network",
      "title": "Toy network",
      "description": "Covers list inputs and required parameters.",
      "category": "Materials Informatics",
      "module": "toy.network_driver",
      "resources": {"cpus": 1, "memory_mb": 500, "walltime_minutes": 5},
      "platform_flags": {"job_name": "-JOBNAME"},
      "inputs": [
        {
          "name": "trajectories",
          "flag": "-i",
          "formats": ["xyz", "trj"],
          "multiple": true
        },
        {
          "name": "reference",
          "flag": "-ref",
          "formats": ["xyz"],
          "required": true
        }
      ],
      "outputs": [{"name": "network", "glob": "*_network.json"}],
      "parameters": [
        {
          "name": "method",
          "flag": "-method",
          "kind": "string",
          "required": true
        },
        {"name": "tags", "flag": "-tags", "kind": "string", "multiple": true},
        {"name": "copy", "flag": "-copy", "kind": "string", "default": "a"}
      ]
    }
  ],
  "pipelines": [
    {
      "id": "toy_demo",
      "title": "Toy demo",
      "description": "Optimize water, then map its reactions.",
      "structures": [
        {
          "key": "structure_water",
          "filename": "water.xyz",
          "content": "3\nwater\nO 0 0 0\nH 0.96 0 0\nH -0.24 0.93 0\n"
        }
      ],
      "steps": [
        {
          "key": "opt",
          "task": "toy_opt",
          "label": "Optimize",
          "after": ["structure_water"],
          "parameters": {"charge": 1}
        },
        {
          "key": "network",
          "task": "toy_network",
          "label": "Reaction network",
          "after": ["opt"],
          "parameters": {"method": "smiles"}
        }
      ]
    }
  ],
  "workflows": [
    {
      "id": "toy_everything",
      "title": "Toy everything",
      "description": "Both toy tasks and their pipeline.",
      "tasks": ["toy_network", "toy_opt"],
      "pipelines": ["toy_demo"]
    },
    {
      "id": "toy_opt_only",
      "title": "Toy optimization",
      "description": "Only the optimization.",
      "tasks": ["toy_opt"]
    }
  ]
}
