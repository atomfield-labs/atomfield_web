# Copy to .env and replace every change-me. Never commit .env.
# Generate strong values with: openssl rand -base64 32

# Postgres. The container applies POSTGRES_PASSWORD only when its data
# volume is first created. To change the password of an existing
# database, also run: ALTER USER postgres PASSWORD '...';
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atomfield_db

# Redis requires this password for every connection.
REDIS_PASSWORD=change-me

# Administrator key, provisioned at startup.
ADMIN_API_KEY=change-me

# Set to true only behind Cloudflare Tunnel, and only when port 8000 is
# not reachable from the internet; otherwise callers can forge their
# address and dodge the key-creation limit.
TRUST_PROXY_HEADERS=false
KEY_CREATION_LIMIT_PER_HOUR=3
