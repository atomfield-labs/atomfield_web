# Copy to .env and replace every change-me. Never commit .env.
# Generate strong values with: openssl rand -base64 32

# Postgres. The container applies POSTGRES_PASSWORD only when its data
# volume is first created. To change the password of an existing
# database, also run: ALTER USER postgres PASSWORD '...';
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atomfield_db

# Redis requires this password for every connection.
REDIS_PASSWORD=change-me

# Administrator key, provisioned at startup.
ADMIN_API_KEY=change-me

# Signing in with Google. Without OIDC_CLIENT_ID nobody can sign in to
# the web app. The redirect is this server as browsers see it, plus
# /api/auth/callback.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Comma-separated: the platform's owners, as Google gives their
# addresses. Anyone else signs in only once a lab has added them
# (docs/labs.md).
OWNER_EMAILS=

# Optional: token of the house agent, which runs jobs on this server
# (docker compose --profile house up). Without one the server runs no
# jobs itself, and people run on their own clusters. The API stores only
# its hash; the agent sends it with every request.
HOUSE_AGENT_TOKEN=

# Signs storage links (file uploads and downloads). Every API process
# must use the same value. Generate with: openssl rand -hex 32
STORAGE_SIGNING_KEY=change-me

# Encrypts each person's own key for an AI vendor. Leave it out and the AI
# buttons stay off. Changing it makes people add their keys again.
# Generate with: openssl rand -hex 32
AI_KEY_SECRET=change-me

# Set to true only behind Cloudflare Tunnel, and only when port 8000 is
# not reachable from the internet; otherwise callers can forge their
# address and dodge the sign-in and pairing limits.
TRUST_PROXY_HEADERS=false

# Port 8000 listens on this machine only. Set this only if what gives
# the server its https name runs on another machine.
# API_BIND=0.0.0.0
